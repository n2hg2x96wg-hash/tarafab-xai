# Copy to .env.local for local development. Placeholders only — never commit
# real values. Production values are set in the hosting provider's
# environment settings (Vercel) and Supabase secrets.

# Public (sent to the browser by design)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Server only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYMENT_GATEWAY_KEY=random-32-plus-character-key
# SUPABASE_FUNCTIONS_URL=https://your-project.functions.supabase.co   (optional)

# Supabase Edge Function secrets (set in Supabase → Edge Functions → Secrets)
# FINNHUB_API_KEY=your-finnhub-key
