# Server Config
NODE_ENV=development
PORT=3001
DATABASE_URL=./data/tarafab.db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=24h

# Frontend
FRONTEND_URL=http://localhost:5173

# Market Data (CoinGecko is free, no key required)
MARKET_DATA_ENABLED=true
MARKET_DATA_API=https://api.coingecko.com/api/v3

# Blockchain verification (optional - set to enable BTC deposit verification)
# Use Blockchair API (free tier available) or your own node
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_PROVIDER=blockchair

# Bitcoin receiving address (demo - replace with your actual address)
BTC_RECEIVING_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
BTC_NETWORK=mainnet

# Payment provider (optional - mock provider used if not configured)
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER=stripe

# Email (optional - for verification and password reset)
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@tarafab.com
EMAIL_KEY=

# Admin
ADMIN_SECRET=change_this_admin_secret
